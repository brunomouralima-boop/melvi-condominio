# ═══════════════════════════════════════════════════════════════
# Melvi Condomínio — Variáveis de ambiente de PRODUÇÃO
# ═══════════════════════════════════════════════════════════════
# 1) Copia este ficheiro para .env:           cp .env.example .env
# 2) Preenche TODOS os valores marcados com <PREENCHER>
# 3) Para gerar secrets fortes:               openssl rand -base64 32
# ═══════════════════════════════════════════════════════════════

# ─── Domínio e contactos ─────────────────────────────────────
# Domínio principal do sistema (SEM https://, SEM www. — só o domínio raiz)
DOMAIN=<PREENCHER>
# Exemplo: DOMAIN=melvi.example.ao

# Email do administrador — usado pelo Let's Encrypt para avisos
ADMIN_EMAIL=<PREENCHER>
# Exemplo: ADMIN_EMAIL=admin@example.ao

# ─── Docker (prefixo do projecto, isola volumes) ─────────────
COMPOSE_PROJECT_NAME=melvi

# ─── PostgreSQL ──────────────────────────────────────────────
DB_NAME=melvi
DB_USER=melvi
# IMPORTANTE: gera senha forte: openssl rand -base64 32
DB_PASSWORD=<PREENCHER>

# ─── JWT (autenticação) ──────────────────────────────────────
# Gera cada um com: openssl rand -base64 64
JWT_ACCESS_SECRET=<PREENCHER>
JWT_REFRESH_SECRET=<PREENCHER>
# TTL dos tokens — defaults razoáveis (descomenta para alterar)
# JWT_ACCESS_TTL=15m
# JWT_REFRESH_TTL=7d

# ─── QR Codes (assinatura HMAC) ──────────────────────────────
# Gera com: openssl rand -base64 32
QR_HMAC_SECRET=<PREENCHER>

# ─── Uploads ─────────────────────────────────────────────────
# Tamanho máximo por upload (MB)
MAX_UPLOAD_MB=8

# ─── URL pública / CORS ──────────────────────────────────────
# Por defeito o sistema assume https://${DOMAIN}. Se ainda NÃO tens domínio
# nem SSL (ambiente só-HTTP por IP), descomenta e ajusta as duas linhas:
#   CORS_ORIGIN=http://77.42.28.190
#   APP_PUBLIC_URL=http://77.42.28.190
# - CORS_ORIGIN: origem(ns) permitida(s) pelo backend (separadas por vírgula).
# - APP_PUBLIC_URL: base usada para construir links absolutos enviados ao
#   utilizador (ex.: link de recuperação de senha). Se não definido, segue o
#   CORS_ORIGIN. Mantém-no igual ao endereço por onde os utilizadores acedem.

# ─── Super Administrador (bootstrap único) ───────────────────
# NÃO são necessárias no .env permanente. São usadas UMA vez, após o primeiro
# deploy, para criar o super admin da plataforma (ver DEPLOY.md):
#   docker compose exec -e SUPERADMIN_EMAIL=admin@exemplo.pt backend \
#     npm run seed:superadmin
# Se omitires SUPERADMIN_PASSWORD, é gerada uma senha forte e impressa UMA vez
# no terminal. NUNCA definas uma senha fixa neste ficheiro.
# SUPERADMIN_EMAIL=admin@exemplo.pt
# SUPERADMIN_NAME=Super Administrador
# SUPERADMIN_PASSWORD=

# ═══════════════════════════════════════════════════════════════
# Notas:
# - CORS_ORIGIN é calculado automaticamente como https://${DOMAIN}
#   (sobrepõe acima se usares só-HTTP por IP)
# - APP_PUBLIC_URL segue o CORS_ORIGIN se não for definido
# - Backend porta 4000 (interna, não exposta)
# - Frontend porta 80 (interna, não exposta)
# - Nginx é o único container com portas públicas (80 e 443)
# ═══════════════════════════════════════════════════════════════
